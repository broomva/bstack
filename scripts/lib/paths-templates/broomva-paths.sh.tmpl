#!/usr/bin/env bash
# shellcheck shell=bash
# GENERATED by scripts/gen_paths.py from references/paths.toml and
# scripts/lib/paths-templates/broomva-paths.sh.tmpl. Do not edit: change those
# and run `python3 scripts/gen_paths.py`.
#
# The Broomva path registry for shell readers (BRO-3216). Source it:
#   . "$BSTACK_REPO/scripts/lib/broomva-paths.sh"
#   policy=$(broomva_repo_path policy "$root")
# Same rules and answers as scripts/broomva_paths.py; bash 3.2 compatible; every
# function keeps its variables local. Return codes: 0 found, 1 absent (or no
# repo), 2 usage error or unknown name, 3 could not read (a git tree, an
# unreadable folder, no git) or a path that would leave the repo. External tools are
# called through `command`, so a caller's function named ls, git, env or id is never
# used in their place. Containment,
# not provenance: .broomva/ and .control/ must be real folders and an entry must
# not be a symlink; who wrote a file is the gates' and Owner Signature's concern.
# Unlike the Python reader, git calls here have no timeout: macOS ships no
# portable `timeout`.

BROOMVA_REGISTRY_SHA256="@@SHA@@"
BROOMVA_REPO_DIR=".broomva"
BROOMVA_REPO_LEGACY_DIR=".control"
# Owner-written governance under both spellings: the literal list gates hold. An
# entry may be a folder (hooks/); matching a written path against it is the gate's job.
BROOMVA_OWNER_PATHS="@@OWNER@@"

# _broomva_repo_entry NAME -> "PATH HAS_LEGACY OWNER" (1 or 0 each). Takes one scope prefix.
_broomva_repo_entry() {
    local n=$1
    case "$n" in repo.*) n=${n#repo.} ;; workspace.*) n=${n#workspace.} ;; esac
    case "$n" in
@@REPO@@
        *) return 2 ;;
    esac
}

# _broomva_state_entry NAME -> PATH for a repo runtime-state name (repo.audit, ...):
# new under $BROOMVA_HOME/state/repos/<repo top-level name>/, legacy .control/.
_broomva_state_entry() {
    local n=$1
    case "$n" in repo.*) n=${n#repo.} ;; workspace.*) n=${n#workspace.} ;; esac
    case "$n" in
@@STATE@@
        *) return 2 ;;
    esac
}

# _broomva_machine_entry NAME -> "PATH LEGACY" (LEGACY is - when none)
_broomva_machine_entry() {
    local n=${1#machine.}
    case "$n" in
@@MACHINE@@
        *) return 2 ;;
    esac
}

# $HOME when set and non-empty, else the account's home (as the Python reader does);
# relative is refused (2); trailing slashes dropped.
_broomva_home() {
    local h=${HOME:-} u
    if [ -z "$h" ]; then
        u=$(command id -un 2>/dev/null) || return 2
        # A letter or _ first: `0`, `1`, `-` would expand bash's directory stack or OLDPWD.
        case "$u" in [A-Za-z_]*) ;; *) return 2 ;; esac
        case "$u" in *[!A-Za-z0-9._@-]*) return 2 ;; esac
        eval "h=~$u"  # u is a plain account name (no shell syntax), checked above
    fi
    _broomva_normpath "$h"  # 2 when relative
}

# A leading ~ or ~/ is the home; a trailing slash is dropped. (~user is left as it
# is: never absolute, so _broomva_absolute refuses it, as Python does.)
_broomva_expand() {
    local h v=$1
    case "$v" in
        \~) v=$(_broomva_home) || return 1 ;;
        \~/*) h=$(_broomva_home) || return 1; v="$h/${v#\~/}" ;;
    esac
    # Trailing slashes and `/.` drop, as Python's normpath drops them.
    while [ "${#v}" -gt 1 ]; do
        case "$v" in */) v=${v%/} ;; */.) v=${v%/.}; [ -n "$v" ] || v=/ ;; *) break ;; esac
    done
    printf '%s\n' "$v"
}

# _broomva_dirname PATH: dirname in bash alone. Each call is shorter or is / or ., so a
# walk up always ends, even when PATH cannot reach the external dirname.
_broomva_dirname() {
    local p=$1
    while [ "${#p}" -gt 1 ] && [ "${p%/}" != "$p" ]; do p=${p%/}; done
    case "$p" in
        /) printf '/\n' ;;
        */*) p=${p%/*}; [ -n "$p" ] || p=/; printf '%s\n' "$p" ;;
        *) printf '.\n' ;;
    esac
}

# _broomva_normpath ABSOLUTE -> the path with `.`, `..` and repeated slashes collapsed,
# lexically, as Python's os.path.normpath does. 2 for a relative path.
_broomva_normpath() {
    local rest=${1#/} out="" c
    case "$1" in /*) ;; *) return 2 ;; esac
    while [ -n "$rest" ]; do
        c=${rest%%/*}
        case "$rest" in */*) rest=${rest#*/} ;; *) rest="" ;; esac
        case "$c" in ""|.) ;; ..) out=${out%/*} ;; *) out="$out/$c" ;; esac
    done
    printf '%s\n' "${out:-/}"
}

# _broomva_links FILE -> its hard-link count, from `ls -ld` (portable across BSD and GNU).
_broomva_links() {
    local l
    l=$(command ls -ld -- "$1" 2>/dev/null) || return 3
    l=${l#* }
    while [ "${l# }" != "$l" ]; do l=${l# }; done
    l=${l%% *}
    case "$l" in ""|*[!0-9]*) return 3 ;; esac
    printf '%s\n' "$l"
}

# git without the caller's GIT_DIR / GIT_WORK_TREE (set inside git hooks and rebase --exec).
_broomva_git() {
    command env -u GIT_DIR -u GIT_WORK_TREE git "$@"
}

# An env root must be absolute (or ~/), as broomva_home.py requires: 2 otherwise.
_broomva_absolute() {
    local v
    v=$(_broomva_expand "$1") || return 2
    _broomva_normpath "$v"  # 2 when relative; `..` collapses as in Python
}

broomva_machine_root() {
    local h
    if [ -n "${BROOMVA_HOME:-}" ]; then _broomva_absolute "$BROOMVA_HOME"; return $?; fi
    h=$(_broomva_home) || return 2
    printf '%s/.broomva\n' "$h"
}

broomva_workspace_root() {
    local ws home
    if [ -n "${BROOMVA_WORKSPACE:-}" ]; then ws=$(_broomva_absolute "$BROOMVA_WORKSPACE") || return 2
    elif [ -n "${MAESTRO_WORKSPACE:-}" ]; then ws=$(_broomva_absolute "$MAESTRO_WORKSPACE") || return 2
    elif [ -n "${BSTACK_WORKSPACE:-}" ]; then ws=$(_broomva_absolute "$BSTACK_WORKSPACE") || return 2
    else home=$(_broomva_home) || return 2; ws="$home/broomva"; fi
    home=$(_broomva_home) || return 2
    # Never $HOME, by spelling (it may not exist yet) or by identity: workspace.*
    # would land in the machine root.
    if [ "$ws" = "$home" ] || [ "$ws" -ef "$home" ]; then return 2; fi
    printf '%s\n' "$ws"
}

# broomva_repo_root [TARGET] -> the git top level of TARGET (else of
# $CLAUDE_PROJECT_DIR; an empty TARGET is none); returns 1 outside a repo, and
# when $HOME is that top level. Never the cwd.
broomva_repo_root() {
    local t=${1:-} top home rc
    [ -n "$t" ] || t=${CLAUDE_PROJECT_DIR:-}
    [ -n "$t" ] || return 1
    # Start from the nearest real folder: one about to be created does not exist yet,
    # and a symlinked one would take git out of the repo.
    if [ -L "$t" ] || [ ! -d "$t" ]; then t=$(_broomva_dirname "$t"); fi
    while { [ -L "$t" ] || [ ! -d "$t" ]; } && [ "$t" != "/" ] && [ "$t" != "." ]; do t=$(_broomva_dirname "$t"); done
    top=$(_broomva_git -C "$t" rev-parse --show-toplevel 2>/dev/null); rc=$?
    [ "$rc" -eq 127 ] && return 3  # git (or env) could not run: never read as "not a repo"
    [ "$rc" -eq 0 ] || return 1
    [ -n "$top" ] || return 1
    home=$(_broomva_home) || return 2  # a bad HOME is a usage error, never "no repo"
    # -ef: the same folder, whatever its case or links.
    if [ "$top" -ef "$home" ]; then return 1; fi
    printf '%s\n' "$top"
}

# broomva_repo_key ROOT -> the repo's name in machine state: its folder name plus the
# first 12 hex digits of the sha256 of its real path (`_root` for /), as in Python.
broomva_repo_key() {
    local root=${1:-} real name sum d rest="" base
    _broomva_root_ok "$root" || return 2
    case "$root" in /*) ;; *) root="$(pwd -P)/$root" ;; esac
    root=$(_broomva_normpath "$root") || return 2
    # The real path of the nearest existing folder, then the rest as named: the same key
    # before the folder exists (a workspace not cloned yet) and after, as in Python.
    d=$root
    while [ ! -d "$d" ]; do
        # A dangling symlink on the way up names a place that does not exist: 2, as in Python.
        if [ -L "$d" ]; then return 2; fi
        base=${d##*/}
        rest="/$base$rest"
        d=$(_broomva_dirname "$d")
    done
    real=$(cd "$d" && pwd -P) || return 3
    real="${real%/}$rest"
    [ -n "$real" ] || real=/
    while [ "${#real}" -gt 1 ] && [ "${real%/}" != "$real" ]; do real=${real%/}; done
    name=${real##*/}
    [ -n "$name" ] || name=_root
    if command -v sha256sum >/dev/null 2>&1; then sum=$(printf '%s' "$real" | command sha256sum)
    elif command -v shasum >/dev/null 2>&1; then sum=$(printf '%s' "$real" | command shasum -a 256)
    else return 3; fi
    [ "${#sum}" -ge 12 ] || return 3
    printf '%s-%s\n' "$name" "${sum:0:12}"
}

# broomva_state_dir ROOT -> where the repo at ROOT keeps its runtime state once moved
broomva_state_dir() {
    local m key
    key=$(broomva_repo_key "$1") || return $?
    m=$(broomva_machine_root) || return 2
    printf '%s/state/repos/%s\n' "$m" "$key"
}

# broomva_repo_rels NAME -> the repo-relative paths NAME may hold, new first.
# Runtime state leaves the repo when it moves, so only its legacy path is in-repo.
broomva_repo_rels() {
    local e p rest
    if e=$(_broomva_state_entry "$1"); then printf '%s\n' "$BROOMVA_REPO_LEGACY_DIR/$e"; return 0; fi
    e=$(_broomva_repo_entry "$1") || return 2
    p=${e%% *}; rest=${e#* }
    printf '%s\n' "$BROOMVA_REPO_DIR/$p"
    if [ "${rest%% *}" = 1 ]; then printf '%s\n' "$BROOMVA_REPO_LEGACY_DIR/$p"; fi
}

# _broomva_root_ok ROOT -> 2 for an empty root or one with a `..` part (a git top level has none)
_broomva_root_ok() {
    [ -n "${1:-}" ] || return 2
    case "/$1/" in */../*) return 2 ;; esac
    return 0
}

# _broomva_contained ROOT -> 3 when .broomva/ or .control/ is a symlink (paths would leave
# the repo) or something other than a folder
_broomva_contained() {
    local d
    for d in "$1/$BROOMVA_REPO_DIR" "$1/$BROOMVA_REPO_LEGACY_DIR"; do
        if [ -L "$d" ]; then return 3; fi
        if [ -e "$d" ] && [ ! -d "$d" ]; then return 3; fi
    done
    return 0
}

# broomva_moved ROOT -> 0 when any name with a legacy location is already under .broomva/
broomva_moved() {
    local p f owner found
    _broomva_root_ok "${1:-}" || return 2
    _broomva_readable "$1" || return 3
    _broomva_contained "$1" || return 3
    # Every entry is checked before answering, as in Python: a symlinked or multiply-linked
    # one later in the list is not hidden by an earlier one that exists.
    found=1
    for p in @@LEGACYLIST@@; do
        f="$1/$BROOMVA_REPO_DIR/$p"
        if [ -e "$f" ] || [ -L "$f" ]; then
            owner=0
            case "$p" in @@OWNERLEGACY@@) owner=1 ;; esac
            _broomva_ok "$f" "$owner" || return 3
            found=0
        fi
    done
    return "$found"
}

# broomva_repo_path NAME ROOT -> where NAME lives on disk in the repo at ROOT
# (ROOT is the repo's top level, as broomva_repo_root prints it)
broomva_repo_path() {
    local e p new old rest legacy owner rc root=${2:-}
    while [ "${#root}" -gt 1 ] && [ "${root%/}" != "$root" ]; do root=${root%/}; done
    _broomva_root_ok "$root" || return 2
    if e=$(_broomva_state_entry "$1"); then
        _broomva_contained "$root" || return 3
        _broomva_readable "$root" || return 3
        new=$(broomva_state_dir "$root") || return $?  # 3 with no hash tool
        new="$new/$e"
        old="$root/$BROOMVA_REPO_LEGACY_DIR/$e"
        _broomva_pick "$new" "$old" 1 "$root"
        return $?
    fi
    e=$(_broomva_repo_entry "$1") || return 2
    [ -n "$root" ] || return 2
    p=${e%% *}; rest=${e#* }; legacy=${rest%% *}; owner=${rest##* }
    new="$root/$BROOMVA_REPO_DIR/$p"
    old="$root/$BROOMVA_REPO_LEGACY_DIR/$p"
    _broomva_contained "$root" || return 3
    _broomva_readable "$root" || return 3
    _broomva_pick "$new" "$old" "$legacy" "$root" "$owner"
}

# Folders that cannot be searched cannot be answered for: 3, as in Python. The repo
# root itself too: under it, .broomva and .control cannot even be stat-ed.
_broomva_readable() {
    local d
    for d in "$1" "$1/$BROOMVA_REPO_DIR" "$1/$BROOMVA_REPO_LEGACY_DIR"; do
        if [ -d "$d" ] && [ ! -x "$d" ]; then return 3; fi
    done
    return 0
}

# _broomva_ok PATH OWNER -> 3 for a symlink, or for an owner-written file with more than
# one link (a hard link elsewhere would let an ungoverned write change it).
_broomva_ok() {
    local n
    if [ -L "$1" ]; then return 3; fi
    # Neither a regular file nor a folder (a FIFO, socket or device): 3, as in Python.
    if [ -e "$1" ] && [ ! -f "$1" ] && [ ! -d "$1" ]; then return 3; fi
    if [ "$2" = 1 ] && [ -f "$1" ]; then
        n=$(_broomva_links "$1") || return 3
        if [ "$n" -gt 1 ]; then return 3; fi
    fi
    return 0
}

# _broomva_pick NEW OLD HAS_LEGACY ROOT [OWNER] -> the migration rule; an existing entry
# that is a symlink (or a multiply-linked owner file) is refused (3).
_broomva_pick() {
    local rc owner=${5:-0}
    if [ -e "$1" ] || [ -L "$1" ] || [ "$3" = 0 ]; then
        if [ -e "$1" ] || [ -L "$1" ]; then _broomva_ok "$1" "$owner" || return 3; fi
        printf '%s\n' "$1"; return 0
    fi
    if [ -e "$2" ] || [ -L "$2" ]; then
        _broomva_ok "$2" "$owner" || return 3
        printf '%s\n' "$2"; return 0
    fi
    if [ -d "$4/$BROOMVA_REPO_LEGACY_DIR" ]; then
        broomva_moved "$4"; rc=$?
        [ "$rc" -eq 3 ] && return 3
        if [ "$rc" -ne 0 ]; then printf '%s\n' "$2"; return 0; fi
    fi
    printf '%s\n' "$1"
}

broomva_workspace_path() {
    local ws
    ws=$(broomva_workspace_root) || return 2
    broomva_repo_path "$1" "$ws"
}

# broomva_machine_path NAME -> where NAME lives under $BROOMVA_HOME (or its legacy)
broomva_machine_path() {
    local e new old
    e=$(_broomva_machine_entry "$1") || return 2
    new=$(broomva_machine_root) || return 2
    new="$new/${e% *}"
    old=${e##* }
    if [ "$old" != - ]; then old=$(_broomva_expand "$old") || return 2; fi
    if [ -e "$new" ] || [ "$old" = - ] || [ ! -e "$old" ]; then printf '%s\n' "$new"
    else printf '%s\n' "$old"; fi
}

# _broomva_tree_contained ROOT REV -> 3 when .broomva or .control is a committed symlink
_broomva_tree_contained() {
    local out line
    out=$(_broomva_git -C "$1" ls-tree --full-tree "$2" -- "$BROOMVA_REPO_DIR" "$BROOMVA_REPO_LEGACY_DIR" 2>/dev/null) || return 3
    while IFS= read -r line; do
        case "${line#*	}" in
            "$BROOMVA_REPO_DIR"|"$BROOMVA_REPO_LEGACY_DIR") if [ "${line%% *}" != 040000 ]; then return 3; fi ;;
        esac
    done <<EOF_TREE
$out
EOF_TREE
    return 0
}

# broomva_tree_path NAME ROOT [REV] -> the path NAME has in git tree REV (default
# HEAD), new before legacy. 1 when the tree holds neither; 3 when it cannot be read.
broomva_tree_path() {
    local e p rest legacy rev=HEAD rel out first="$BROOMVA_REPO_DIR"
    # An empty REV given explicitly is a usage error, as in Python; only an absent one is HEAD.
    if [ "$#" -ge 3 ]; then rev=$3; fi
    if e=$(_broomva_state_entry "$1"); then
        p=$e; legacy=1
        first="$BROOMVA_REPO_LEGACY_DIR"  # runtime state is never under .broomva/ in a tree
    else
        e=$(_broomva_repo_entry "$1") || return 2
        p=${e%% *}; rest=${e#* }; legacy=${rest%% *}
    fi
    _broomva_root_ok "${2:-}" || return 2
    case "$rev" in -*|"") return 2 ;; esac
    _broomva_git -C "$2" rev-parse --verify --quiet "$rev^{tree}" >/dev/null 2>&1 || return 3
    _broomva_tree_contained "$2" "$rev" || return 3
    for rel in "$first/$p" "$BROOMVA_REPO_LEGACY_DIR/$p"; do
        if [ "$rel" = "$BROOMVA_REPO_LEGACY_DIR/$p" ] && [ "$legacy" != 1 ]; then break; fi
        out=$(_broomva_git -C "$2" ls-tree --full-tree "$rev" -- "$rel" 2>/dev/null) || return 3
        # "MODE TYPE SHA<tab>PATH": a committed symlink (120000) is refused, as in Python.
        if [ -n "$out" ] && [ "${out#*	}" = "$rel" ]; then
            case "${out%% *}" in 040000|100644|100755) ;; *) return 3 ;; esac  # no symlink, no gitlink
            printf '%s\n' "$rel"; return 0
        fi
    done
    return 1
}
