{
  "name": "bstack",
  "interface": {
    "displayName": "bstack"
  },
  "plugins": [
    {
      "name": "bstack-skills",
      "description": "The required bstack companion skills (references/companion-skills.yaml, required: true) plus the bstack primer, installed from the broomva/skills monorepo. Pair with the bstack plugin; for every other skill add the broomva/skills marketplace.",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/broomva/skills.git",
        "path": "skills"
      },
      "skills": [
        "./governance/bstack",
        "./orchestration/autonomous",
        "./governance/cross-review",
        "./governance/dogfood",
        "./orchestration/role-x",
        "./governance/agentic-control-kernel",
        "./governance/harness-engineering-playbook",
        "./knowledge/kg",
        "./knowledge/bookkeeping",
        "./tooling/prompt-library",
        "./orchestration/p9",
        "./orchestration/persist",
        "./research/deep-dive-research-orchestrator",
        "./tooling/skills-catalog"
      ],
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity"
    }
  ]
}
