        "./skills/governance/dogfood",
        "./skills/orchestration/role-x",
        "./skills/governance/agentic-control-kernel",
        "./skills/governance/harness-engineering-playbook",
        "./skills/knowledge/kg",
        "./skills/knowledge/bookkeeping",
        "./skills/tooling/prompt-library",
        "./skills/orchestration/p9",
        "./skills/orchestration/persist",
        "./skills/research/deep-dive-research-orchestrator",
        "./skills/tooling/skills-catalog"
