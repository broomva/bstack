# Python build artifacts
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so

# macOS
.DS_Store

# Local-only scaffolding produced by running bstack (bootstrap/doctor/install-rcs)
# against the bstack repo itself (self-dogfood). These are generated artifacts,
# never committed — the bstack source repo uses .github/workflows/ci.yml and
# .git/hooks, not the L3 stability workflow / .githooks the installer scaffolds.
.control/
.claude/
.githooks/

# Bootstrap OUTPUT, not source. scripts/bootstrap.sh renders these into whatever
# repo it runs in (assets/templates/METALAYER.md.template + assets/templates/
# schemas/*.schema.json). They were committed by accident into #116 and removed by
# #117; the files were deleted but the CAUSE was never closed, so the full test
# suite regenerated them and a `git add -A` swept the identical 605 lines back in.
# Anchored at the repo root so the TEMPLATES (assets/templates/...) and the tracked
# schemas/*.v1.json source files stay tracked.
/METALAYER.md
/schemas/*.schema.json
.github/workflows/l3-stability.yml
